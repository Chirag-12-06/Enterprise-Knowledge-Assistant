function buildRagPrompt(question, context, history = []) {
  const conversation = history
    .map(
      (message) =>
        `${message.role}: ${message.content}`
    )
    .join("\n");

  return `
You are an enterprise knowledge assistant.

Use the provided knowledge base context to answer
the user's question.

Conversation history:
${conversation}

Relevant knowledge base:
${context}

Current question:
${question}

Instructions:
- Use conversation history to understand references
  to previous messages.
- Use the knowledge base as the source of factual
  information.
- Do not invent information.
- If the answer is not present in the knowledge base,
  say that you could not find the information.
`;
}

module.exports = {
  buildRagPrompt,
};